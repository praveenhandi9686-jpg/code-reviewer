FLASK_ENV=development
SECRET_KEY=change-this
DATABASE_URL=sqlite:///codescan.db
MAX_CODE_CHARS=200000

# AI settings - all three are required, no quotes, no spaces around "="
# OpenAI-compatible example URL: https://api.openai.com/v1/chat/completions
# Anthropic example URL:         https://api.anthropic.com/v1/messages
AI_API_KEY=
AI_MODEL=MODEL=gpt-5.5
AI_API_URL=https://api.openai.com/v1/responses
